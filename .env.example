# Flask
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-this-to-a-random-secret-key

# Database
# Leave unset in development to use SQLite at instance/dental_clinic.db
DATABASE_URL=

# Days the "Confirm this appointment" link in the clinic notification email stays valid
APPOINTMENT_CONFIRM_TOKEN_MAX_AGE_DAYS=30

# IANA timezone of the clinic — decides which of today's time slots have already passed
CLINIC_TIMEZONE=Asia/Karachi

# Mail — sends go through Resend's HTTPS API (app/utils/email.py), not SMTP.
# The sender domain must be verified in the Resend dashboard; a gmail.com address
# will be rejected. Use onboarding@resend.dev to test before your domain verifies
# (it only delivers to your Resend signup address).
RESEND_API_KEY=

# SMTP settings below are unused by the send path; MAIL_DEFAULT_SENDER is still read.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=Soha Kayani Dental Clinic <your-email@gmail.com>
CLINIC_NOTIFY_EMAIL=front-desk@sohakayanidental.pk
# Set to True in development to skip real SMTP sends (emails are logged instead)
MAIL_SUPPRESS_SEND=True

# Clinic info
CLINIC_NAME=Soha Kayani Dental Clinic
CLINIC_PHONE=+92 51 111 555 000
CLINIC_ADDRESS=F3 Centre of Informatics, Commercial Area, Sector B - Zaraj Housing Scheme, Opposite Giga Mall, Islamabad
CLINIC_WHATSAPP_NUMBER=923001234567
GOOGLE_MAPS_QUERY=F3 Centre of Informatics, Zaraj Housing Scheme, Islamabad, Pakistan

# Voice assistant — two providers are supported. Set ONE key; Gemini wins if both are set.
# Leave both blank and the microphone button simply won't appear; the rest of the site
# works exactly as before.

# Gemini Live (has a free tier). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Confirm with GET /v1beta/models before changing — the id in Google's docs isn't visible
# to every key. The "-latest" alias survives preview snapshots being retired.
# gemini-3.1-flash-live-preview answers in about 1.5s where 2.5-native-audio took 12s.
# Fall back to gemini-2.5-flash-native-audio-latest if the preview model regresses.
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
# Voice the assistant speaks with — browse them at https://aistudio.google.com
GEMINI_LIVE_VOICE=Kore
# Show an English translation under each transcript line, so staff can follow a conversation
# held in Urdu or Pashto. The patient still hears and speaks their own language throughout —
# this is display only. Off by default because it sends transcript text to Google a second
# time. Gemini path only.
VOICE_TRANSLATE_ENABLED=False
GEMINI_TRANSLATE_MODEL=gemini-flash-lite-latest
VOICE_TRANSLATE_RATE_LIMIT=120

# OpenAI Realtime (no free tier — needs billing set up).
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
# Voice the assistant speaks with: marin, cedar, alloy, echo, shimmer
OPENAI_REALTIME_VOICE=marin
# Set to False to hide the assistant even when a key is configured
VOICE_ASSISTANT_ENABLED=True
# Each conversation costs money — max sessions per visitor, and the window in seconds
VOICE_TOKEN_RATE_LIMIT=10
VOICE_TOKEN_RATE_WINDOW=3600
# Relay socket reconnects per visitor per window. Higher than the session limit because the
# socket reopens each time the assistant navigates the patient to another page.
VOICE_STREAM_RATE_LIMIT=60

# Social
FACEBOOK_URL=https://facebook.com
INSTAGRAM_URL=https://instagram.com
TWITTER_URL=https://twitter.com
LINKEDIN_URL=https://linkedin.com
